# Local dev port overrides for `make dev`. Copy to dev.ports.env (gitignored)
# and uncomment what you need; unset values keep the standard defaults. These
# also work as plain env vars (e.g. from .envrc). dev.sh derives every dependent
# URL from them, so one change keeps the whole stack wired.

# LEADACE_FRONTEND_PORT=5273   # vite
# LEADACE_API_PORT=8787        # API Worker
# LEADACE_MCP_PORT=8788        # MCP Worker

# Inspector ports auto-shift to <port>+1000 with a custom worker port; pin only
# if that still collides.
# LEADACE_API_INSPECTOR_PORT=9229
# LEADACE_MCP_INSPECTOR_PORT=9230

# Supabase ports live in supabase/config.toml (shift via SUPABASE_PORT_OFFSET).
# A custom MCP port also needs: export LEADACE_MCP_URL=http://localhost:<port>/mcp
