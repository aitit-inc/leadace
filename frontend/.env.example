PUBLIC_API_URL=http://localhost:8787
PUBLIC_MCP_URL=http://localhost:8788
PUBLIC_SUPABASE_URL=http://localhost:54321
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 'cloud' enables Stripe upgrade UI and the billing portal. 'self-hosted'
# (default) hides billing entirely and assumes the API is running on the
# unlimited tier. Mirrors backend LEADACE_EDITION.
PUBLIC_LEADACE_EDITION=self-hosted

# Stripe price IDs (retrieve from Stripe Dashboard after creating Products & Prices)
# Only used when PUBLIC_LEADACE_EDITION=cloud.
PUBLIC_STRIPE_PRICE_STARTER_MONTHLY=price_...
PUBLIC_STRIPE_PRICE_STARTER_YEARLY=price_...
PUBLIC_STRIPE_PRICE_PRO_MONTHLY=price_...
PUBLIC_STRIPE_PRICE_PRO_YEARLY=price_...
PUBLIC_STRIPE_PRICE_SCALE_MONTHLY=price_...
PUBLIC_STRIPE_PRICE_SCALE_YEARLY=price_...
