{
  "name": "lead-ace-api",
  "main": "src/api/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "development",
    "APP_URL": "http://localhost:5273",
    // This Worker's own public origin. Hosted-agent jobs build unsubscribe /
    // inquiry link hosts from it (a request-bound send derives it from the URL).
    "API_URL": "http://localhost:8787",
    // Default for local dev. Production env redeclares this as "cloud".
    // Anything other than "cloud" disables Stripe routes and resolves every
    // tenant to the 'unlimited' plan. See backend/src/domain/edition.ts.
    "LEADACE_EDITION": "self-hosted"
  },
  // Secrets (set via wrangler secret or .dev.vars):
  //   DATABASE_URL
  //   SUPABASE_JWT_SECRET   (REQUIRED — needed to verify HS256 access tokens minted by lead-ace-mcp.
  //                          Supabase-issued frontend tokens go through the JWKS path first and don't
  //                          need this, but MCP-forwarded requests carry HS256 tokens that only the
  //                          HS256 fallback in verifySupabaseJwt can validate. Use the same value as
  //                          on lead-ace-mcp; pull it from Supabase Dashboard → Settings → API → JWT Secret.)
  //   SUPABASE_URL
  //   STRIPE_SECRET_KEY
  //   STRIPE_WEBHOOK_SECRET
  //   GOOGLE_CLIENT_ID            (Google Cloud Console → OAuth Client → Web application)
  //   GOOGLE_CLIENT_SECRET        (paired with GOOGLE_CLIENT_ID, used for refresh_token exchange)
  //   GMAIL_TOKEN_ENCRYPTION_KEY  (random 32+ char passphrase; used as pgp_sym_encrypt key)
  //   UNSUBSCRIBE_TOKEN_SECRET    (REQUIRED — random 32+ char passphrase; HMAC-SHA256 key for signing
  //                                /unsubscribe/:token links embedded in outbound emails. Tokens are
  //                                long-lived — never rotate this in place once emails are out;
  //                                rotation invalidates every prior unsubscribe link.)
  //   OPENAI_API_KEY              (REQUIRED — sk-... key from platform.openai.com. Powers every
  //                                hosted-agent stage, the chat, onboarding from a URL and
  //                                inquiry-chat; without it none of these run.)
  //   SHOWCASE_PROJECT_ID         (optional — project id the public GET /api/live scoreboard
  //                                shows. Unset → /api/live answers 404.)
  //   SENTRY_DSN                  (cloud-only error tracking. Set on the hosted deploy to send
  //                                unhandled errors to Sentry; unset for local/self-host, where
  //                                Sentry is a no-op — see src/api/index.ts withSentry wrapper.)
  // Same namespace as lead-ace-mcp: DELETE /me/account revokes the user's MCP
  // token families here so a plugin left configured stops refreshing. Local dev:
  // wrangler simulates KV regardless of the id.
  "kv_namespaces": [
    {
      "binding": "MCP_OAUTH_STORE",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ],
  // Hosted-agent jobs: one Workflow instance per jobs row (src/jobs/workflow.ts).
  // The hourly cron and the chat / Web UI / MCP start instances through the
  // `JOBS` binding; the class is exported from src/api/index.ts.
  "workflows": [
    {
      "name": "lead-ace-jobs",
      "binding": "JOBS",
      "class_name": "LeadAceJobWorkflow"
    }
  ],
  // The chat's thread runner: one Durable Object per thread (src/api/thread-runner.ts);
  // the class is exported from src/api/index.ts.
  "durable_objects": {
    "bindings": [
      {
        "name": "THREADS",
        "class_name": "ThreadRunner"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ThreadRunner"]
    }
  ],
  // The handler is `scheduled` in src/api/index.ts.
  "triggers": {
    // 0 3 = verifier balance watch; 0 * = hourly server-side reply poll.
    "crons": ["0 3 * * *", "0 * * * *"]
  },
}
