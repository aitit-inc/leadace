{
  "name": "lead-ace-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:api": "wrangler dev --config wrangler.api.jsonc --inspector-port 9229 --test-scheduled",
    "dev:mcp": "wrangler dev --config wrangler.mcp.jsonc --port 8788 --inspector-port 9230",
    "deploy:api": "wrangler deploy --config wrangler.api.jsonc",
    "deploy:mcp": "wrangler deploy --config wrangler.mcp.jsonc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed-master-documents": "tsx scripts/seed-master-documents.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sentry/cloudflare": "^10.64.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.28",
    "jose": "^6.2.3",
    "openai": "^6.46.0",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260629.1",
    "@hono/zod-validator": "^0.8.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-zod": "^0.8.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "~4.107.0"
  }
}
